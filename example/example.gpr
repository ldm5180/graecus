with "../graecus.gpr";

--  Standalone example main demonstrating graecus.  Mirrors sml-ada's
--  example crate: MODE selects -O3/-O0 with per-mode object and exec dirs.
project Example is

   type Mode_Type is ("release", "debug");
   Mode : Mode_Type := external ("MODE", "release");

   for Source_Dirs use ("src");
   for Object_Dir use "obj/" & Mode;
   for Exec_Dir use "bin/" & Mode;
   for Create_Missing_Dirs use "True";
   for Main use ("iv_of_premium.adb");

   package Builder is
      for Switches ("Ada") use ("-j0"); --  build on all cores
   end Builder;

   package Compiler is
      Common := ("-g", "-gnata", "-gnatwa", "-gnatwe", "-gnat2022");

      case Mode is
         when "release" =>
            for Default_Switches ("Ada") use Common & ("-O3");

         when "debug" =>
            for Default_Switches ("Ada") use Common & ("-O0");
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback.
   end Binder;

end Example;
